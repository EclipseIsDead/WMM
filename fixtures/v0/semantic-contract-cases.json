      "name": "endpoint correlation leaves 18 uncertain",
      "applicability": {"kind": "interval", "axisDefinitionDigest": "1111111111111111111111111111111111111111111111111111111111111111", "start": {"kind": "unknown"}, "endExclusive": {"kind": "exact", "position": "20"}},
      "query": {"format": "wmm.temporal-query/1", "mode": "at", "axisDefinitionDigest": "1111111111111111111111111111111111111111111111111111111111111111", "position": "18"},
      "expected": {"format": "wmm.temporal-comparison/1", "kind": "comparable", "truth": "sometimes"}
