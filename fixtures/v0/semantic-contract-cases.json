      "right": {
        "account": {"kind": "ref", "id": "account:canonical"},
        "jurisdiction": {"kind": "ref", "id": "polity:valen"},
        "recognitionFrame": {"kind": "ref", "id": "frame:court"}
      },
      "expected": {
        "format": "wmm.scope-comparison/1",
        "result": "same",
        "components": {"account": "same", "jurisdiction": "same", "recognitionFrame": "same"}
      }
    },
    {
      "name": "two unresolved markers are not a definite match",
      "left": {
        "account": {"kind": "ref", "id": "account:canonical"},
        "jurisdiction": {"kind": "unresolved"},
        "recognitionFrame": {"kind": "ref", "id": "frame:court"}
      },
      "right": {
        "account": {"kind": "ref", "id": "account:canonical"},
        "jurisdiction": {"kind": "unresolved"},
        "recognitionFrame": {"kind": "ref", "id": "frame:court"}
