      "expected": {
        "format": "wmm.scope-comparison/1",
        "result": "unresolved",
        "components": {"account": "same", "jurisdiction": "unresolved", "recognitionFrame": "same"}
      }
    },
    {
      "name": "a definite difference dominates another unresolved component",
      "left": {
        "account": {"kind": "ref", "id": "account:canonical"},
        "jurisdiction": {"kind": "unresolved"},
        "recognitionFrame": {"kind": "ref", "id": "frame:court"}
      },
      "right": {
        "account": {"kind": "ref", "id": "account:chronicle"},
        "jurisdiction": {"kind": "ref", "id": "polity:valen"},
        "recognitionFrame": {"kind": "ref", "id": "frame:court"}
      },
      "expected": {
        "format": "wmm.scope-comparison/1",
        "result": "different",
        "components": {"account": "different", "jurisdiction": "unresolved", "recognitionFrame": "same"}
      }
    },
    {
      "name": "notApplicable is an explicit sentinel",
      "left": {
        "account": {"kind": "ref", "id": "account:canonical"},
        "jurisdiction": {"kind": "notApplicable"},
        "recognitionFrame": {"kind": "notApplicable"}
      },
      "right": {
        "account": {"kind": "ref", "id": "account:canonical"},
        "jurisdiction": {"kind": "notApplicable"},
        "recognitionFrame": {"kind": "notApplicable"}
      },
      "expected": {
        "format": "wmm.scope-comparison/1",
        "result": "same",
        "components": {"account": "same", "jurisdiction": "same", "recognitionFrame": "same"}
      }
    }
