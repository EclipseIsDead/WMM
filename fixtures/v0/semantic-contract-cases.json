      "query": {"format": "wmm.temporal-query/1", "mode": "at", "axisDefinitionDigest": "1111111111111111111111111111111111111111111111111111111111111111", "position": "13"},
      "expected": {"format": "wmm.temporal-comparison/1", "kind": "comparable", "truth": "never"}
    },
    {
