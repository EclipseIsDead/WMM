      "applicability": {"kind": "interval", "axisDefinitionDigest": "1111111111111111111111111111111111111111111111111111111111111111", "start": {"kind": "unboundedPast"}, "endExclusive": {"kind": "unboundedFuture"}},
      "query": {"format": "wmm.temporal-query/1", "mode": "throughout", "axisDefinitionDigest": "1111111111111111111111111111111111111111111111111111111111111111", "start": "100", "endExclusive": "200"},
