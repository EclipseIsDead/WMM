{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wmm:semantic-contracts:v1-draft-01",
  "$comment": "V0 scope, evidence, temporal-query, and result-algebra wire contracts.",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "RecordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9_-]+$"
    },
    "AssertionId": {
      "type": "string",
      "pattern": "^asrt:[0-9a-f]{64}$"
    },
    "IntegerPosition": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "IdSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecordId"
      },
      "uniqueItems": true
    },
    "AssertionIdSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AssertionId"
      },
      "uniqueItems": true
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "enum": ["info", "warning", "error", "blocker"]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "severity", "message"],
      "additionalProperties": false
    },
    "SupportBody": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.support/1"
        },
        "worldId": {
          "$ref": "urn:wmm:contract-kit:core-v1-draft-03#/$defs/WorldId"
        },
        "claimId": {
          "$ref": "#/$defs/AssertionId"
        },
        "sourceId": {
          "$ref": "#/$defs/RecordId"
        },
        "stance": {
          "enum": ["supports", "challenges"]
        },
        "locator": {
          "type": "object",
          "properties": {
            "definitionDigest": {
              "$ref": "#/$defs/Digest"
            },
            "data": true
          },
          "required": ["definitionDigest", "data"],
          "additionalProperties": false
        },
        "interpretationMethodDefinitionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "sourceContentDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "format",
        "worldId",
        "claimId",
        "sourceId",
        "stance",
        "locator",
        "interpretationMethodDefinitionDigest"
      ],
      "additionalProperties": false
    },
    "ScopeComparison": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.scope-comparison/1"
        },
        "result": {
          "enum": ["same", "different", "unresolved"]
        },
        "components": {
          "type": "object",
          "properties": {
            "account": {
              "enum": ["same", "different", "unresolved"]
            },
            "jurisdiction": {
              "enum": ["same", "different", "unresolved"]
            },
            "recognitionFrame": {
              "enum": ["same", "different", "unresolved"]
            }
          },
          "required": ["account", "jurisdiction", "recognitionFrame"],
          "additionalProperties": false
        }
      },
      "required": ["format", "result", "components"],
      "additionalProperties": false
    },
    "EvidenceStatus": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.evidence-status/1"
        },
        "status": {
          "enum": ["supported", "challenged", "supported-and-challenged", "unsupported"]
        },
        "supportingIds": {
          "$ref": "#/$defs/IdSet"
        },
        "challengingIds": {
          "$ref": "#/$defs/IdSet"
        }
      },
      "required": ["format", "status", "supportingIds", "challengingIds"],
      "additionalProperties": false
    },
    "FamilySupport": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.family-support/1"
        },
        "status": {
          "enum": ["positive-only", "negative-only", "both", "neither"]
        },
        "positiveIds": {
          "$ref": "#/$defs/IdSet"
        },
        "negativeIds": {
          "$ref": "#/$defs/IdSet"
        }
      },
      "required": ["format", "status", "positiveIds", "negativeIds"],
      "additionalProperties": false
    },
    "PointQuery": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.temporal-query/1"
        },
        "mode": {
          "const": "at"
        },
        "axisDefinitionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "position": {
          "$ref": "#/$defs/IntegerPosition"
        }
      },
      "required": ["format", "mode", "axisDefinitionDigest", "position"],
      "additionalProperties": false
    },
    "IntervalQuery": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.temporal-query/1"
        },
        "mode": {
          "enum": ["intersects", "throughout"]
        },
        "axisDefinitionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "start": {
          "$ref": "#/$defs/IntegerPosition"
        },
        "endExclusive": {
          "$ref": "#/$defs/IntegerPosition"
        }
      },
      "required": ["format", "mode", "axisDefinitionDigest", "start", "endExclusive"],
      "additionalProperties": false
    },
    "TemporalQuery": {
      "oneOf": [
        {
          "$ref": "#/$defs/PointQuery"
        },
        {
          "$ref": "#/$defs/IntervalQuery"
        }
      ]
    },
    "TemporalComparison": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "wmm.temporal-comparison/1"
            },
            "kind": {
              "const": "comparable"
            },
            "truth": {
              "enum": ["always", "never", "sometimes"]
            }
          },
          "required": ["format", "kind", "truth"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "wmm.temporal-comparison/1"
            },
            "kind": {
              "const": "incomparable"
            },
            "reason": {
              "enum": ["unmappedAxis", "missingBounds", "unsupportedRelation"]
            }
          },
          "required": ["format", "kind", "reason"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "wmm.temporal-comparison/1"
            },
            "kind": {
              "const": "excluded"
            },
            "reason": {
              "const": "applicabilityType"
            }
          },
          "required": ["format", "kind", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "ClaimQueryItem": {
      "type": "object",
      "properties": {
        "assertionId": {
          "$ref": "#/$defs/AssertionId"
        },
        "polarity": {
          "enum": ["positive", "negative"]
        },
        "scope": {
          "$ref": "#/$defs/ScopeComparison"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalComparison"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "familySupport": {
          "$ref": "#/$defs/FamilySupport"
        }
      },
      "required": [
        "assertionId",
        "polarity",
        "scope",
        "temporal",
        "evidence",
        "familySupport"
      ],
      "additionalProperties": false
    },
    "ClaimQueryItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClaimQueryItem"
      }
    },
    "ClaimQueryResult": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.claim-query-result/1"
        },
        "scope": {
          "$ref": "urn:wmm:contract-kit:core-v1-draft-03#/$defs/Scope"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalQuery"
        },
        "definite": {
          "$ref": "#/$defs/ClaimQueryItems"
        },
        "possible": {
          "$ref": "#/$defs/ClaimQueryItems"
        },
        "unresolved": {
          "$ref": "#/$defs/ClaimQueryItems"
        },
        "excluded": {
          "$ref": "#/$defs/ClaimQueryItems"
        },
        "scopeCoverage": {
          "const": "exhaustive"
        }
      },
      "required": [
        "format",
        "scope",
        "temporal",
        "definite",
        "possible",
        "unresolved",
        "excluded",
        "scopeCoverage"
      ],
      "additionalProperties": false
    },
    "AbsenceInputSelection": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.absence-input-selection/1"
        },
        "worldId": {
          "$ref": "urn:wmm:contract-kit:core-v1-draft-03#/$defs/WorldId"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/Digest"
        },
        "target": {
          "$ref": "urn:wmm:contract-kit:core-v1-draft-03#/$defs/Exists"
        },
        "scope": {
          "$ref": "urn:wmm:contract-kit:core-v1-draft-03#/$defs/Scope"
        },
        "temporal": {
          "$ref": "#/$defs/PointQuery"
        },
        "membershipAssertionIds": {
          "$ref": "#/$defs/AssertionIdSet"
        }
      },
      "required": [
        "format",
        "worldId",
        "snapshotDigest",
        "target",
        "scope",
        "temporal",
        "membershipAssertionIds"
      ],
      "additionalProperties": false
    },
    "AbsenceCandidateEvaluation": {
      "type": "object",
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/RecordId"
        },
        "membershipAssertionIds": {
          "$ref": "#/$defs/AssertionIdSet"
        },
        "membership": {
          "enum": ["member", "possible", "conflicting", "unresolved"]
        },
        "eligibilityAssertionIds": {
          "$ref": "#/$defs/AssertionIdSet"
        },
        "eligibility": {
          "enum": [
            "eligible",
            "possibly-eligible",
            "ineligible",
            "conflicting",
            "unresolved"
          ]
        }
      },
      "required": [
        "candidateId",
        "membershipAssertionIds",
        "membership",
        "eligibilityAssertionIds",
        "eligibility"
      ],
      "additionalProperties": false
    },
    "AbsenceEvaluationReceipt": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.absence-evaluation-receipt/1"
        },
        "algorithm": {
          "const": "bundled-absence-point-v1"
        },
        "inputSelection": {
          "$ref": "#/$defs/AbsenceInputSelection"
        },
        "inputSelectionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "evaluationDigest": {
          "$ref": "#/$defs/Digest"
        },
        "positiveCoverageAssertionIds": {
          "$ref": "#/$defs/AssertionIdSet"
        },
        "negativeCoverageAssertionIds": {
          "$ref": "#/$defs/AssertionIdSet"
        },
        "eligibilityAssertionIds": {
          "$ref": "#/$defs/AssertionIdSet"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AbsenceCandidateEvaluation"
          }
        },
        "status": {
          "enum": ["established", "not-established", "unsupported"]
        },
        "reason": {
          "enum": [
            "all-candidates-ineligible",
            "coverage-not-established",
            "coverage-conflicted",
            "coverage-unresolved",
            "membership-not-established",
            "membership-conflicted",
            "membership-unresolved",
            "candidate-eligibility-conflicted",
            "candidate-eligibility-unresolved",
            "recorded-witness",
            "unsupported-semantics"
          ]
        }
      },
      "required": [
        "format",
        "algorithm",
        "inputSelection",
        "inputSelectionDigest",
        "evaluationDigest",
        "positiveCoverageAssertionIds",
        "negativeCoverageAssertionIds",
        "eligibilityAssertionIds",
        "candidates",
        "status",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "established" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reason": { "const": "all-candidates-ineligible" },
              "inputSelection": {
                "properties": {
                  "membershipAssertionIds": { "minItems": 1 }
                }
              },
              "positiveCoverageAssertionIds": { "minItems": 1 },
              "candidates": {
                "minItems": 1,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/AbsenceCandidateEvaluation" },
                    {
                      "properties": {
                        "membership": { "const": "member" },
                        "eligibility": { "const": "ineligible" }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "not-established" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "coverage-not-established",
                  "coverage-conflicted",
                  "coverage-unresolved",
                  "membership-not-established",
                  "membership-conflicted",
                  "membership-unresolved",
                  "candidate-eligibility-conflicted",
                  "candidate-eligibility-unresolved",
                  "recorded-witness"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "unsupported" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "reason": { "const": "unsupported-semantics" } }
          }
        }
      ],
      "additionalProperties": false
    },
    "AbsenceQueryResult": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wmm.absence-query-result/1"
        },
        "target": {
          "$ref": "urn:wmm:contract-kit:core-v1-draft-03#/$defs/Exists"
        },
        "scope": {
          "$ref": "urn:wmm:contract-kit:core-v1-draft-03#/$defs/Scope"
        },
        "temporal": {
          "$ref": "#/$defs/PointQuery"
        },
        "conclusion": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "absence-declared",
                "absence-derived",
                "absence-declared-and-derived",
                "witness-recorded",
                "conflicting",
                "absence-not-established",
                "unresolved"
              ]
            },
            "bases": {
              "type": "array",
              "items": {
                "enum": ["declared", "derived"]
              },
              "uniqueItems": true,
              "maxItems": 2
            }
          },
          "required": ["status", "bases"],
          "additionalProperties": false
        },
        "declaration": {
          "type": "object",
          "properties": {
            "status": {
              "enum": ["recorded", "possible", "unresolved", "not-recorded"]
            },
            "definiteAssertionIds": {
              "$ref": "#/$defs/AssertionIdSet"
            },
            "possibleAssertionIds": {
              "$ref": "#/$defs/AssertionIdSet"
            },
            "unresolvedAssertionIds": {
              "$ref": "#/$defs/AssertionIdSet"
            }
          },
          "required": [
            "status",
            "definiteAssertionIds",
            "possibleAssertionIds",
            "unresolvedAssertionIds"
          ],
          "additionalProperties": false
        },
        "witnesses": {
          "type": "object",
          "properties": {
            "status": {
              "enum": ["recorded", "possible", "unresolved", "none-recorded"]
            },
            "existentialAssertionIds": {
              "$ref": "#/$defs/AssertionIdSet"
            },
            "possibleExistentialAssertionIds": {
              "$ref": "#/$defs/AssertionIdSet"
            },
            "unresolvedExistentialAssertionIds": {
              "$ref": "#/$defs/AssertionIdSet"
            },
            "candidateIds": {
              "$ref": "#/$defs/IdSet"
            },
            "possibleCandidateIds": {
              "$ref": "#/$defs/IdSet"
            },
            "unresolvedCandidateIds": {
              "$ref": "#/$defs/IdSet"
            }
          },
          "required": [
            "status",
            "existentialAssertionIds",
            "possibleExistentialAssertionIds",
            "unresolvedExistentialAssertionIds",
            "candidateIds",
            "possibleCandidateIds",
            "unresolvedCandidateIds"
          ],
          "additionalProperties": false
        },
        "derivation": {
          "$ref": "#/$defs/AbsenceEvaluationReceipt"
        }
      },
      "required": [
        "format",
        "target",
        "scope",
        "temporal",
        "conclusion",
        "declaration",
        "witnesses",
        "derivation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "conclusion": {
                "properties": { "status": { "const": "absence-declared" } }
              }
            }
          },
          "then": {
            "properties": {
              "conclusion": {
                "properties": { "bases": { "const": ["declared"] } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "conclusion": {
                "properties": { "status": { "const": "absence-derived" } }
              }
            }
          },
          "then": {
            "properties": {
              "conclusion": {
                "properties": { "bases": { "const": ["derived"] } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "conclusion": {
                "properties": {
                  "status": { "const": "absence-declared-and-derived" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "conclusion": {
                "properties": { "bases": { "const": ["declared", "derived"] } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "conclusion": {
                "properties": {
                  "status": {
                    "enum": ["witness-recorded", "absence-not-established"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "conclusion": {
                "properties": { "bases": { "maxItems": 0 } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "conclusion": {
                "properties": { "status": { "const": "conflicting" } }
              }
            }
          },
          "then": {
            "properties": {
              "conclusion": {
                "properties": { "bases": { "const": ["declared"] } }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "CommonResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "wmm.response/1"
            },
            "apiVersion": {
              "const": "wmm/1"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "const": "success"
            },
            "execution": {
              "const": "completed"
            },
            "data": true,
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Diagnostic"
              }
            }
          },
          "required": ["format", "apiVersion", "requestId", "outcome", "execution", "data", "diagnostics"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "wmm.response/1"
            },
            "apiVersion": {
              "const": "wmm/1"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "const": "partial"
            },
            "execution": {
              "const": "incomplete"
            },
            "data": true,
            "diagnostics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Diagnostic"
              }
            }
          },
          "required": ["format", "apiVersion", "requestId", "outcome", "execution", "data", "diagnostics"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "wmm.response/1"
            },
            "apiVersion": {
              "const": "wmm/1"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "const": "error"
            },
            "execution": {
              "enum": ["completed", "incomplete"]
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["code", "message"],
              "additionalProperties": false
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Diagnostic"
              }
            }
          },
          "required": ["format", "apiVersion", "requestId", "outcome", "execution", "error", "diagnostics"],
          "additionalProperties": false
        }
      ]
    },
    "ValidationStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "wmm.validation-status/1"
            },
            "execution": {
              "const": "completed"
            },
            "validity": {
              "enum": ["valid", "invalid"]
            }
          },
          "required": ["format", "execution", "validity"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "wmm.validation-status/1"
            },
            "execution": {
              "const": "incomplete"
            },
            "validity": {
              "enum": ["invalid", "undetermined"]
            }
          },
          "required": ["format", "execution", "validity"],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SupportBody"
    },
    {
      "$ref": "#/$defs/ScopeComparison"
    },
    {
      "$ref": "#/$defs/EvidenceStatus"
    },
    {
      "$ref": "#/$defs/FamilySupport"
    },
    {
      "$ref": "#/$defs/TemporalQuery"
    },
    {
      "$ref": "#/$defs/TemporalComparison"
    },
    {
      "$ref": "#/$defs/ClaimQueryResult"
    },
    {
      "$ref": "#/$defs/AbsenceQueryResult"
    },
    {
      "$ref": "#/$defs/CommonResponse"
    },
    {
      "$ref": "#/$defs/ValidationStatus"
    }
  ]
}
