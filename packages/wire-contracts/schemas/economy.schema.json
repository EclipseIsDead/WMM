        },
        "boundary": {
          "$ref": "#/$defs/Boundary"
        },
        "coverage": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "partial",
                "complete-as-declared",
                "unknown"
              ]
            },
            "description": {
              "$ref": "urn:wmm:authoring#/$defs/Text"
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "additionalProperties": false
        },
        "citations": {
          "$ref": "urn:wmm:authoring#/$defs/Citations"
        },
        "kind": {
          "const": "stock-observation"
        },
        "status": {
          "enum": [
            "observed",
            "reported-estimate"
          ]
        },
        "owner": {
          "$ref": "#/$defs/Role"
        },
        "custodian": {
          "$ref": "#/$defs/Role"
        },
        "location": {
          "$ref": "#/$defs/Role"
        },
        "availableUse": {
          "$ref": "#/$defs/Declaration"
        },
        "reference": {
          "$ref": "#/$defs/AuthoringPoint"
        },
        "subjectId": {
          "$ref": "urn:wmm:authoring#/$defs/EntityId"
        },
        "context": {
          "$ref": "urn:wmm:authoring#/$defs/Context"
        },
        "applicability": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "invariant"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "resourceId",
        "quantity",
        "description",
        "method",
        "boundary",
        "coverage",
        "citations",
        "kind",
        "status",
        "owner",
        "custodian",
        "location",
        "availableUse",
        "reference",
        "subjectId",
        "context",
        "applicability"
      ],
      "additionalProperties": false
    },
