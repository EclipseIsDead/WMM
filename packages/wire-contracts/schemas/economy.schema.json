          "required": [
            "kind",
            "relativeTo"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "resourceId",
        "quantity",
        "description",
        "method",
        "boundary",
        "coverage",
        "citations",
        "kind",
        "promisor",
        "recipient",
        "destination",
        "reference",
        "timing"
      ],
      "additionalProperties": false
    },
