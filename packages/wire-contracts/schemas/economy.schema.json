            },
            "endExclusive": {
              "$ref": "#/$defs/Position"
            }
          },
          "required": [
            "kind",
            "axisKey",
            "start",
            "endExclusive"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/Unmapped"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ]
    },
    "StockObservationValue": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:wmm:authoring#/$defs/Slug"
        },
        "resourceId": {
          "$ref": "urn:wmm:authoring#/$defs/EntityId"
        },
        "quantity": {
          "$ref": "urn:wmm:measurement#/$defs/Quantity"
        },
        "description": {
          "$ref": "urn:wmm:authoring#/$defs/Text"
        },
        "method": {
          "$ref": "#/$defs/Declaration"
        },
        "boundary": {
          "$ref": "#/$defs/Boundary"
        },
        "coverage": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "partial",
                "complete-as-declared",
                "unknown"
              ]
            },
            "description": {
              "$ref": "urn:wmm:authoring#/$defs/Text"
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "additionalProperties": false
        },
        "citations": {
          "$ref": "urn:wmm:authoring#/$defs/Citations"
        },
        "kind": {
          "const": "stock-observation"
        },
        "status": {
          "enum": [
            "observed",
            "reported-estimate"
          ]
        },
        "owner": {
          "$ref": "#/$defs/Role"
        },
        "custodian": {
          "$ref": "#/$defs/Role"
        },
        "location": {
          "$ref": "#/$defs/Role"
        },
        "availableUse": {
          "$ref": "#/$defs/Declaration"
        },
        "reference": {
          "$ref": "#/$defs/Point"
        }
      },
      "required": [
        "id",
        "resourceId",
        "quantity",
        "description",
        "method",
        "boundary",
        "coverage",
        "citations",
        "kind",
        "status",
        "owner",
        "custodian",
        "location",
        "availableUse",
        "reference"
      ],
      "additionalProperties": false
    },
    "AuthoringStockObservation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:wmm:authoring#/$defs/Slug"
