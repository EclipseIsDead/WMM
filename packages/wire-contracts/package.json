{
  "name": "@wmm/wire-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/core-contracts.schema.json": "./schemas/core-contracts.schema.json",
    "./schemas/semantic-contracts.schema.json": "./schemas/semantic-contracts.schema.json",
    "./schemas/world-records.schema.json": "./schemas/world-records.schema.json",
    "./schemas/workspace-v1.schema.json": "./schemas/workspace-v1.schema.json",
    "./schemas/api-v1.schema.json": "./schemas/api-v1.schema.json",
    "./schemas/authoring.schema.json": "./schemas/authoring.schema.json",
    "./schemas/entity-context.schema.json": "./schemas/entity-context.schema.json",
    "./schemas/actor.schema.json": "./schemas/actor.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
